{
  "info": {"name":"E-Commerce Inventory Capstone API","description":"API tests for the backend capstone","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:5000/api"},{"key":"accessToken","value":""},{"key":"refreshToken","value":""},{"key":"categoryId","value":""},{"key":"productId","value":""},{"key":"orderId","value":""}],
  "item":[
    {"name":"Health","request":{"method":"GET","url":"http://localhost:5000/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('API healthy',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Login - Customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"customer@example.com\",\"password\":\"Customer12345\"}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login successful',()=>pm.response.to.have.status(200));","const d=pm.response.json().data; pm.collectionVariables.set('accessToken',d.accessToken); pm.collectionVariables.set('refreshToken',d.refreshToken);"]}}]},
    {"name":"Login - Admin","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin@example.com\",\"password\":\"Admin12345\"}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Admin login successful',()=>pm.response.to.have.status(200));","const d=pm.response.json().data; pm.collectionVariables.set('accessToken',d.accessToken); pm.collectionVariables.set('refreshToken',d.refreshToken);"]}}]},
    {"name":"My Profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/users/me"}},
    {"name":"Categories","request":{"method":"GET","url":"{{baseUrl}}/categories"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Categories returned',()=>pm.response.to.have.status(200));","if(pm.response.json().data.items.length)pm.collectionVariables.set('categoryId',pm.response.json().data.items[0]._id);"]}}]},
    {"name":"Browse Products","request":{"method":"GET","url":"{{baseUrl}}/products?page=1&limit=10"}},
    {"name":"Add Cart Item (set productId first)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productId\":\"{{productId}}\",\"quantity\":1}"},"url":"{{baseUrl}}/cart/items"}},
    {"name":"View Cart","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/cart"}},
    {"name":"Checkout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"deliveryAddress\":\"123 Demo Street, Delhi\"}"},"url":"{{baseUrl}}/orders/checkout"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if(pm.response.code===201)pm.collectionVariables.set('orderId',pm.response.json().data.order._id);"]}}]},
    {"name":"My Orders","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/orders/mine"}},
    {"name":"Sales Report (Admin token)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/reports/sales"}},
    {"name":"Inventory Report (Admin token)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/reports/inventory"}},
    {"name":"Refresh Token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refreshToken}}\"}"},"url":"{{baseUrl}}/auth/refresh"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Refresh succeeded',()=>pm.response.to.have.status(200));","if(pm.response.code===200){pm.collectionVariables.set('accessToken',pm.response.json().data.accessToken);pm.collectionVariables.set('refreshToken',pm.response.json().data.refreshToken);}"]}}]},
    {"name":"Unauthorized - Profile","request":{"method":"GET","url":"{{baseUrl}}/users/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Unauthorized',()=>pm.response.to.have.status(401));"]}}]},
    {"name":"Invalid Register Validation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"\",\"email\":\"not-an-email\",\"password\":\"123\"}"},"url":"{{baseUrl}}/auth/register"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Validation error',()=>pm.response.to.have.status(400));"]}}]}
  ]
}
